{"nodes": [{"id": "tools_trace_doc", "label": "Trace & Trace Report Guide", "file_type": "document", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tools_trace_trace_tool", "label": "trace.py Perfetto Trace Recorder", "file_type": "concept", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records binary Perfetto traces over ADB for predefined launcher scenarios (home, cold, coldsys, nav, custom)."}, {"id": "tools_trace_trace_report_tool", "label": "trace_report.py Latency Reporter", "file_type": "concept", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analyzes pftrace files using trace_processor_shell to report time to first frame, lifecycle slice breakdowns, frame rates, and missed deadlines."}, {"id": "tools_trace_scenarios", "label": "Launcher Trace Scenarios", "file_type": "concept", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardized scenarios: home (warm launcher resume), cold (am start -W after force-stop), coldsys (restart after memory pressure kill), nav (24 D-pad moves), and custom steps."}, {"id": "tools_trace_repeat_runs_rule", "label": "Five Repeat Runs and Median Comparison Rule", "file_type": "rationale", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Record 5 runs per build on the same TV with same config, theme, and wallpaper. Compare medians."}, {"id": "tools_trace_keep_starred_runs_rule", "label": "Keep Starred Outlier Runs Rule", "file_type": "rationale", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A run over twice the median is starred; keep and report them rather than dropping them, as they usually reflect genuine memory pressure on 1 GB TVs."}, {"id": "tools_trace_cold_intent_rule", "label": "Cold Starts Must Use HOME Intent Rule", "file_type": "rationale", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bench.py and cold trace send MAIN with HOME category. Starting only the component creates a regular task beside Home causing duplicate instances."}, {"id": "tools_trace_privacy_rule", "label": "Never Commit pftrace Files Rule", "file_type": "rationale", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never commit .pftrace files because they contain the TV process list."}, {"id": "tools_trace_off_thread_latency_rule", "label": "No Latency Gain from Off-Thread Work Rationale", "file_type": "rationale", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expect no latency gain from off-main-thread work: it removes work from the main thread, but does not shorten the elapsed time to the first frame."}, {"id": "tools_trace_frametimeline_requirement", "label": "Android 12+ FrameTimeline Prerequisite", "file_type": "concept", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame times and missed deadlines require Perfetto FrameTimeline, available only on Android 12 and later."}, {"id": "tools_trace_service_prerequisite", "label": "Android 9/10 Tracing Service Setup (persist.traced.enable)", "file_type": "concept", "source_file": "trace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Andr