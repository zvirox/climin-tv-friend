<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="580dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_m3_dialog"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/settings_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Material 3 Expressive UI Customization"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/m3_outline" />

        <!-- Light Mode / Dark Mode Switch -->
        <LinearLayout
            android:id="@+id/row_toggle_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Dark Mode (Solid Colors)"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_dark_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Accent Color Theme Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_theme_label"
            android:textColor="@color/m3_on_surface"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/theme_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_theme_coral"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_coral"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_theme_indigo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_indigo"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_theme_emerald"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_emerald"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_theme_ocean"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_ocean"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_theme_amber"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_amber"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_theme_violet"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:text="@string/theme_name_violet"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/m3_outline" />

        <!-- 24H Clock Toggle -->
        <LinearLayout
            android:id="@+id/row_toggle_clock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_clock_label"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_24h_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Weather Temperature Unit Toggle -->
        <LinearLayout
            android:id="@+id/row_toggle_weather_temp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weather Unit: Celsius (°C)"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Accessibility Status Card -->
        <LinearLayout
            android:id="@+id/row_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_accessibility_status"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_accessibility_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_accessibility_enabled"
                android:textColor="@color/m3_status_online"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_open_system_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:text="@string/settings_open_system_settings"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:text="@string/settings_close"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
