<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:paddingStart="32dp"
    android:paddingTop="20dp"
    android:paddingEnd="32dp"
    android:paddingBottom="20dp">

    <!-- ======================================================== -->
    <!-- LEFT PANE: BRAND, COLOR PALETTES & SYSTEM STATUS          -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/settings_left_pane"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="#E63946" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.02"
                    android:text="Your UI • Win 8.1 Expressive"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: ACTIVE COLOR PALETTES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/outfit_bold"
            android:letterSpacing="0.06"
            android:text="ACTIVE COLOR PALETTES"
            android:textColor="#8E8E93"
            android:textSize="10sp" />

        <!-- Palette 1: Crimson Wine Dark -->
        <LinearLayout
            android:id="@+id/btn_palette_crimson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_win8_tile_rounded"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="Crimson Wine Dark"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#000000"
                    android:gravity="center"
                    android:text="#000000"
                    android:textColor="#888888"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#1F1F1F"
                    android:gravity="center"
                    android:text="#1F1F1F"
                    android:textColor="#AAAAAA"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#6E6E6E"
                    android:gravity="center"
                    android:text="#6E6E6E"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#6C0010"
                    android:gravity="center"
                    android:text="#6C0010"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#350008"
                    android:gravity="center"
                    android:text="#350008"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Palette 2: Cyber Teal & Oxblood -->
        <LinearLayout
            android:id="@+id/btn_palette_teal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_win8_tile_rounded"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="Cyber Teal &amp; Oxblood"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#007A7A"
                    android:gravity="center"
                    android:text="#007A7A"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#004040"
                    android:gravity="center"
                    android:text="#004040"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#3D0000"
                    android:gravity="center"
                    android:text="#3D0000"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#7A0000"
                    android:gravity="center"
                    android:text="#7A0000"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Palette 3: Honeydew & Prussian Light -->
        <LinearLayout
            android:id="@+id/btn_palette_honeydew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_win8_tile_rounded"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="Honeydew &amp; Prussian Light"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#E63946"
                    android:gravity="center"
                    android:text="#E63946"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#F1FAEE"
                    android:gravity="center"
                    android:text="#F1FAEE"
                    android:textColor="#1D3557"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#A8DADC"
                    android:gravity="center"
                    android:text="#A8DADC"
                    android:textColor="#1D3557"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#457B9D"
                    android:gravity="center"
                    android:text="#457B9D"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#1D3557"
                    android:gravity="center"
                    android:text="#1D3557"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- SYSTEM STATUS Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_win8_tile_rounded"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:letterSpacing="0.04"
                android:text="SYSTEM STATUS"
                android:textColor="#8E8E93"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/text_settings_system_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/outfit_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Memory: Lean APK\nSuper Mode: 3D Flip Active\nWeather: Open-Meteo Patan"
                android:textColor="#CCCCCC"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Back to Home Button -->
        <LinearLayout
            android:id="@+id/btn_close_settings"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_win8_tile_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_input"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/outfit_bold"
                android:text="Back to Home"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#222222" />

    <!-- ======================================================== -->
    <!-- RIGHT PANE: PREFERENCES CARDS GRID (WINE/DARK BACKGROUND) -->
    <!-- ======================================================== -->
    <ScrollView
        android:id="@+id/settings_right_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#200005"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. START SCREEN & LIVE TILES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:letterSpacing="0.06"
                android:text="START SCREEN &amp; LIVE TILES"
                android:textColor="#E63946"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <!-- Card 1: Super Mode -->
                <LinearLayout
                    android:id="@+id/row_toggle_home_layout"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/text_home_layout_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Super Mode (Live Tile\n3D Flip\nRecommendations)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <io.yourtv.home.view.M3Switch
                        android:id="@+id/switch_home_layout"
                        android:layout_width="58dp"
                        android:layout_height="28dp" />
                </LinearLayout>

                <!-- Card 2: Dark Mode -->
                <LinearLayout
                    android:id="@+id/row_toggle_dark_mode"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Dark Mode\n(Solid Win 8.1 + M3\nTokens)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <io.yourtv.home.view.M3Switch
                        android:id="@+id/switch_dark_mode"
                        android:layout_width="58dp"
                        android:layout_height="28dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. THEME & EXPRESSIVE PALETTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:letterSpacing="0.06"
                android:text="THEME &amp; EXPRESSIVE PALETTES"
                android:textColor="#E63946"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <!-- Card 1: Color Palette Preset -->
                <LinearLayout
                    android:id="@+id/row_theme_presets"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/text_palette_preset_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Color Palette Preset\nCrimson Wine / Cyber Teal /\nHoneydew Light"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_palette"
                        android:tint="#E63946" />
                </LinearLayout>

                <!-- Card 2: Adaptive Dynamic Colors -->
                <LinearLayout
                    android:id="@+id/row_toggle_adaptive_color"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Adaptive Dynamic\nColor Engine"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <io.yourtv.home.view.M3Switch
                        android:id="@+id/switch_adaptive_color"
                        android:layout_width="58dp"
                        android:layout_height="28dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. CLOCK & WEATHER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:letterSpacing="0.06"
                android:text="CLOCK &amp; WEATHER"
                android:textColor="#E63946"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Card 1: Reorder / Hold OK info -->
                <LinearLayout
                    android:id="@+id/row_reorder_info"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_input"
                        android:tint="#AAAAAA" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Customize &amp; Resize Start\nGrid Tiles (HOLD OK)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 2: 24-Hour Vertical Clock -->
                <LinearLayout
                    android:id="@+id/row_toggle_clock"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:lineSpacingMultiplier="1.1"
                        android:text="24-Hour Vertical Clock\n(No Seconds)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <io.yourtv.home.view.M3Switch
                        android:id="@+id/switch_24h_clock"
                        android:layout_width="58dp"
                        android:layout_height="28dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Weather Unit & City -->
            <LinearLayout
                android:id="@+id/row_toggle_weather_temp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_win8_tile_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/text_weather_unit_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Weather Unit: Celsius (°C) • Patan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <io.yourtv.home.view.M3Switch
                    android:id="@+id/switch_weather_temp"
                    android:layout_width="58dp"
                    android:layout_height="28dp" />
            </LinearLayout>

            <!-- 4. SYSTEM & SHORTCUTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:letterSpacing="0.06"
                android:text="SYSTEM &amp; CONNECTIVITY"
                android:textColor="#E63946"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_system_settings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Android TV"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_open_wifi_settings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Wi-Fi"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_open_bluetooth_settings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_win8_tile_rounded"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Bluetooth"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Reset Start Screen Order Row -->
            <LinearLayout
                android:id="@+id/row_reset_home_apps"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_win8_tile_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Reset Start Grid Tile Order to Default"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Reset"
                    android:textColor="#E63946"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
