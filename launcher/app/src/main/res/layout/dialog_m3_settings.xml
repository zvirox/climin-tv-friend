<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="580dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_m3_dialog"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/settings_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/outfit_regular"
            android:text="Material 3 Expressive UI Customization"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/m3_outline" />

        <!-- 1. Dark Mode / Light Mode Switch -->
        <LinearLayout
            android:id="@+id/row_toggle_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="Dark Mode (Solid Colors)"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_dark_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- 2. Adaptive Color Toggle (Section 8) -->
        <LinearLayout
            android:id="@+id/row_toggle_adaptive_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="Adaptive Color (Seed from Focused App)"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_adaptive_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- 3. Home Layout Switch (Minimal vs Super) (Section 9) -->
        <LinearLayout
            android:id="@+id/row_toggle_home_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/text_home_layout_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="Home Layout: Minimal Mode"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_home_layout_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_medium"
                android:text="Toggle"
                android:textColor="@color/m3_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. Weather City Selector (Section 4) -->
        <LinearLayout
            android:id="@+id/row_weather_city"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/text_city_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="Weather City: New York"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_medium"
                android:text="Change"
                android:textColor="@color/m3_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. 24H Clock Toggle -->
        <LinearLayout
            android:id="@+id/row_toggle_clock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="@string/settings_clock_label"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_24h_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- 6. Weather Temperature Unit Toggle -->
        <LinearLayout
            android:id="@+id/row_toggle_weather_temp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_medium"
                android:text="Weather Unit: Celsius (°C)"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_open_system_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/settings_open_system_settings"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/settings_close"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
