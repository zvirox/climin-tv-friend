<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="@dimen/app_grid_card_width"
    android:layout_height="@dimen/app_grid_card_height"
    android:layout_margin="8dp"
    android:background="@drawable/bg_m3_grid_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/app_grid_icon_size"
            android:layout_height="@dimen/app_grid_icon_size"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/m3_on_surface"
            android:textSize="@dimen/app_grid_title_size" />
    </LinearLayout>

    <!-- Star / Home Indicator Badge -->
    <TextView
        android:id="@+id/badge_home_shelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_m3_pill_chip"
        android:fontFamily="@font/outfit_medium"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="★ HOME"
        android:textColor="@color/m3_dark_pri"
        android:textSize="9sp"
        android:visibility="gone" />

</FrameLayout>
