<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="180dp"
    android:layout_height="116dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_m3_hero_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Icon Squircle (Left) & "Open" Chip (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Icon Tile -->
        <FrameLayout
            android:id="@+id/icon_tile_container"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_m3_circle_button">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- "Open" Pill Badge (Active only when focused) -->
        <TextView
            android:id="@+id/badge_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m3_pill_chip"
            android:fontFamily="@font/outfit_medium"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="Open"
            android:textColor="@color/m3_dark_onpri"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: App Name & Subtitle -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_medium"
        android:maxLines="1"
        android:textColor="@color/m3_dark_onbg"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/app_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_regular"
        android:maxLines="1"
        android:alpha="0.78"
        android:textColor="@color/m3_dark_osv"
        android:textSize="10sp" />

</LinearLayout>
