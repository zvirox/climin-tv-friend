<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_dark_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="20dp"
    android:paddingEnd="36dp"
    android:paddingBottom="20dp">

    <!-- Full-Screen Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="All Applications"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/text_all_apps_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/outfit_regular"
                android:text="Press OK to launch • Hold OK to pin / unpin from Home shelf"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="11.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_close_all_apps"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_m3_pill_chip"
            android:fontFamily="@font/outfit_medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Close (Back)"
            android:textColor="@color/m3_on_surface"
            android:textSize="11.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/m3_outline" />

    <!-- Full-Screen Apps Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_recycler_all_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />

</LinearLayout>
