<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ZONE 1: DEDICATED TOP HEADER BAND (NO TILES ALLOWED HERE) -->
    <FrameLayout
        android:id="@+id/top_header_row"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top-Left: Vertical Clock (No Seconds) + Date + Greeting -->
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_clock_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.80"
                    android:text="04"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_super_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_pill_chip"
                    android:fontFamily="@font/outfit_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="✦ SUPER MODE ACTIVE"
                    android:textColor="#80DEEA"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clock_minute_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_clock_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.80"
                    android:text="30"
                    android:textColor="#007A7A"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_clock_am_pm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="3dp"
                    android:fontFamily="@font/outfit_bold"
                    android:includeFontPadding="false"
                    android:text="PM"
                    android:textColor="#007A7A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false"
                android:text="Monday, 26 October 2026"
                android:textColor="#E0FFFFFF"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/text_clock_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/outfit_bold"
                android:includeFontPadding="false"
                android:text="Good Afternoon • Patan • 32°C Clear sky"
                android:textColor="#B0FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Top-Right: Quick Action Circular Buttons -->
        <LinearLayout
            android:id="@+id/header_controls_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_circle_inputs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false">
                <ImageView
                    android:id="@+id/ic_circle_inputs"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_input" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_circle_ui_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false">
                <ImageView
                    android:id="@+id/ic_circle_ui_settings"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_palette" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_circle_wifi"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false">
                <ImageView
                    android:id="@+id/ic_circle_wifi"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wifi" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_circle_bluetooth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false">
                <ImageView
                    android:id="@+id/ic_circle_bluetooth"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bluetooth" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_circle_tv_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_m3_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false">
                <ImageView
                    android:id="@+id/ic_circle_tv_settings"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ZONE 2: HORIZONTALLY SCROLLING 4-ROW WINDOWS 8.1 START GRID -->
    <HorizontalScrollView
        android:id="@+id/win8_horizontal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:overScrollMode="never"
        android:paddingStart="44dp"
        android:paddingTop="6dp"
        android:paddingEnd="44dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/win8_tile_canvas"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false" />
    </HorizontalScrollView>

</LinearLayout>
