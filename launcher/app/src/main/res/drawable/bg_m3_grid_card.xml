<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/m3_corner_grid" />
            <solid android:color="@color/m3_surface_container_highest" />
            <stroke android:width="@dimen/m3_focus_stroke_width" android:color="@color/m3_card_focused_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/m3_corner_grid" />
            <solid android:color="@color/m3_surface_container" />
            <stroke android:width="1dp" android:color="@color/m3_outline" />
        </shape>
    </item>
</selector>
