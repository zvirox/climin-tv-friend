<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/m3_surface_container_highest" />
            <stroke android:width="2.5dp" android:color="@color/m3_card_focused_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/m3_surface_container" />
            <stroke android:width="1dp" android:color="@color/m3_outline" />
        </shape>
    </item>
</selector>
